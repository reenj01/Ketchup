# Copy to .env (gitignored) and fill in. Never commit .env or the key file.
#   cp .env.example .env

# Muse Spark Open on Baseten (the main brain). Required.
BASETEN_API_KEY=

# Meta Model API, the backup brain (muse-spark-1.3). Optional.
META_API_KEY=

# Google service account key that can read/write the two demo calendars.
# Save the downloaded JSON key in the repo root as service-account.json
# (gitignored) and leave this line as is. A path elsewhere works too.
GOOGLE_SA_FILE=service-account.json

# Or, instead of the file: paste the whole key JSON on one line.
# GOOGLE_SA_JSON=
