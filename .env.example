# Copy to .env (gitignored) and fill in. Never commit .env or the key file.
#   cp .env.example .env

# Muse Spark Open on Baseten (the main brain). With neither this nor META_API_KEY set,
# Ketchup replays the recorded calls in replays/demo (labelled "replay").
BASETEN_API_KEY=

# Meta Model API, the backup brain (muse-spark-1.3). Optional.
META_API_KEY=

# Google service account key that can read/write the two demo calendars. Optional:
# without it (or with KETCHUP_CALENDAR=mock) Ketchup uses the mock calendar.
# Save the downloaded JSON key in the repo root as service-account.json
# (gitignored) and leave this line as is. A path elsewhere works too.
GOOGLE_SA_FILE=service-account.json

# Or, instead of the file: paste the whole key JSON on one line.
# GOOGLE_SA_JSON=

# Live hardware demo page (optional): the deployed web simulator's URL. scripts/demo_up.sh then
# prints a private link to its /live page, which shows the tap server's log and model calls live.
# KETCHUP_LIVE_BASE=https://<your-modal-app>.modal.run
