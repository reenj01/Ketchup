# Mayo's Dot (Raspberry Pi 5): starts pi_pebble.py on boot and keeps it running.
# Install: see deploy/dots/README.md. Logs: journalctl -u ketchup-dot -f
[Unit]
Description=Ketchup Dot (Mayo, Raspberry Pi)
Wants=network-online.target
After=network-online.target sound.target
# keep retrying forever (the Mac server may come up minutes later)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ireenj
WorkingDirectory=/home/ireenj
# KETCHUP_SERVER, PEBBLE_ID, META_API_KEY, ... (chmod 600, never in this file)
EnvironmentFile=/home/ireenj/ketchup-dot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ireenj/pebvenv/bin/python /home/ireenj/dot_heartbeat.py /home/ireenj/pebvenv/bin/python /home/ireenj/pi_pebble.py
Restart=always
RestartSec=3
KillSignal=SIGINT
# SIGINT to dot_heartbeat.py only; it passes it to the Dot (LED off), SIGKILL after the timeout
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
